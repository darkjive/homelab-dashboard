{
  "name": "homelab-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Futuristic homelab control center with real-time system monitoring, AI agent terminals, and cyberpunk aesthetics",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:ollama": "bash scripts/start-ollama.sh",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "desktop": "electron .",
    "desktop:prod": "vite build && NODE_ENV=production electron .",
    "build": "tsc -b && pnpm typecheck:server && vite build",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "start": "pnpm dev:all"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.560.0",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-grid-layout": "^2.1.1",
    "react-resizable": "^3.0.5",
    "recharts": "^3.6.0",
    "systeminformation": "^5.28.0",
    "turndown": "^7.2.2",
    "validator": "^13.15.26",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^43.1.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0"
  }
}
