# Copy to .env and adjust if needed. Defaults work for local Ollama.

# Ollama server URL (used by the chatbot backend proxy).
OLLAMA_URL=http://localhost:11434

# Network interface the backend binds to. Default 127.0.0.1 (loopback only —
# no auth on any endpoint). Set to 0.0.0.0 only if you understand the risk.
# BIND_HOST=127.0.0.1
